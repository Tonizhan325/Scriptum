@page
@model RegisterModel
@{
    ViewData["Title"] = "Registro";
}

<style>
    .custom-background {
        min-height: 100vh;
        padding: 2rem 0;
    }

    .register-card {
        background: white;
        border: none;
        border-radius: 1.5rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        transition: transform 0.3s ease;
        padding: 2.5rem;
    }

        .register-card:hover {
            transform: translateY(-5px);
        }

    .btn-register {
        background: #2C3E50;
        border: none;
        padding: 12px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

        .btn-register:hover {
            background: #1a2b3a;
            transform: scale(1.02);
        }

    h1, h2 {
        color: #1f2937;
    }

    .form-floating > .form-control:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.25);
    }

    hr {
        background: linear-gradient(90deg, transparent, #4f46e5, transparent);
        height: 2px;
        border: none;
        margin: 1.5rem 0;
        opacity: 0.3;
    }

    .login-link {
        color: #2C3E50;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }

        .login-link:hover {
            color: #1a2b3a;
            text-decoration: underline;
        }
</style>

<div class="custom-background">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <h1 class="text-center mb-4">@ViewData["Title"]</h1>

                <div class="register-card">
                    <h2 class="text-center mb-4">Crea una nueva cuenta</h2>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@gmail.com" />
                            <label asp-for="Input.Email">Correo electrónico</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="contraseña" />
                            <label asp-for="Input.Password">Contraseña</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="contraseña" />
                            <label asp-for="Input.ConfirmPassword">Confirmar contraseña</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-register text-white mb-3">
                            Registrar
                        </button>

                        <hr />

                        <div class="text-center">
                            <p class="mb-0">
                                ¿Ya tienes una cuenta?
                                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="login-link">
                                    Accede aquí
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}