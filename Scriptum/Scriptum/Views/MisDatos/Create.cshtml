@model Scriptum.Models.Usuario

@{
    ViewData["Title"] = "Tus datos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    
    .page-header {
        background: #2C3E50;
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 2rem 2rem;
        box-shadow: 0 10px 30px rgba(44, 62, 80, 0.3);
    }

        .page-header h1 {
            margin: 0;
            font-weight: 600;
            font-size: 2.5rem;
        }

        .page-header p {
            margin: 0.5rem 0 0 0;
            opacity: 0.9;
        }

    .form-card {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        padding: 2.5rem;
        border: 1px solid #e5e7eb;
        transition: transform 0.3s ease;
        margin-bottom: 2rem;
    }

        .form-card:hover {
            transform: translateY(-5px);
        }

    .form-title {
        color: #1f2937;
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .form-title svg {
            color: #2C3E50;
        }

    .form-subtitle {
        color: #6b7280;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f3f4f6;
    }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.95rem;
    }

        .form-label i {
            color: #2C3E50;
            margin-right: 0.25rem;
        }

    .form-control-custom {
        border: 2px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        width: 100%;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

        .form-control-custom:focus {
            border-color: #2C3E50;
            box-shadow: 0 0 0 3px rgba(44, 62, 80, 0.1);
            outline: none;
        }

    .btn-create {
        background: #2C3E50;
        color: white;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        width: 100%;
        justify-content: center;
        margin-top: 1rem;
    }

        .btn-create:hover {
            background: #1a2b3a;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(44, 62, 80, 0.4);
        }


    .btn-back {
        background: white;
        color: #2C3E50;
        border: 2px solid #2C3E50;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        margin-top: 1.5rem;
    }

        .btn-back:hover {
            background: #2C3E50;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(44, 62, 80, 0.3);
        }


    hr {
        background: linear-gradient(90deg, transparent, #2C3E50, transparent);
        height: 2px;
        border: none;
        margin: 1.5rem 0;
        opacity: 0.2;
    }

 
    .text-danger {
        color: #ef4444;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }

    .input-icon-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
    }

    .input-icon-field {
        padding-left: 2.5rem;
    }

    .info-message {
        background: #f3f4f6;
        border-left: 4px solid #2C3E50;
        padding: 1rem;
        border-radius: 0.75rem;
        margin-bottom: 2rem;
        color: #4b5563;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .info-message svg {
            color: #2C3E50;
            flex-shrink: 0;
            width: 20px;
            height: 20px;
        }
</style>

<div class="page-header">
    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <p>Completa tu información para comenzar</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card">

                <div class="form-title">
                    <svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                    </svg>
                    Bienvenido
                </div>

                <div class="info-message">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                    <span>Es necesario poner tu nombre antes de poder empezar a utilizar la aplicación web</span>
                </div>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-group-custom">
                        <label asp-for="Nombre" class="form-label">
                            <i class="fas fa-user"></i> Nombre completo
                        </label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">
                                <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                                </svg>
                            </span>
                            <input asp-for="Nombre" class="form-control-custom input-icon-field" placeholder="Ej: Juan Pérez" />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <hr />

                    <button type="submit" class="btn-create">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                        Comenzar
                    </button>
                </form>

                <div class="text-center">
                    <a asp-action="Index" asp-controller="Home" class="btn-back">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                        </svg>
                        Volver al inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

