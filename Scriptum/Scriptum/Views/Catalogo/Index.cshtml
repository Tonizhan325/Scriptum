@model CatalogoViewModel;

@{
    ViewData["Title"] = "Index";
}
<style>
    aside {
        position: fixed;
        right: -200px; 
        top: 25%;
        width: 200px;
        background: #2C3E50;
        transition: right 0.3s ease;
        z-index: 1000;
        padding: 2rem;
        border-radius: 0 0 0 10px;
    }

        aside.active {
            right: 0;
        }

    #btn-toggle-filter {
        position: absolute;
        left: -60px; 
        top: 0px;
        background: #2C3E50;
        color: white;
        border: none;
        padding: 10px;
        cursor: pointer;
        border-radius: 5px 0 0 5px;
    }

    section > article {
        display: flex;
        gap: 1rem;
    }

    .btn-pagina {
        border: 1.5px solid #2C3E50;
        color: #2C3E50;
        background: transparent;
    }

    .btn-pagina:hover {
        background: rgba(44, 62, 80, 0.1);
        color: #2C3E50;
    }

    .btn-pagina-activa {
        background-color: #2C3E50;
        border: 1.5px solid #2C3E50;
        color: white;
    }
</style>

<aside id="filtro-sidebar">
    <button id="btn-toggle-filter" title="Filtrar" style="font-size:36px;">
        🔍
    </button>

    <h3 style="color:white; text-align:center; margin-bottom: 1rem;">Filtrar por género</h3>
    @foreach (var item in Model.Generos)
    {
        <a asp-action="Index"
           asp-route-generoId="@item.Id"
           asp-route-tipoRecurso="@Model.TipoSeleccionado"
           asp-route-buscar="@Model.FiltroBusqueda"
           style="color: #ecf0f1; display:block; margin-bottom: 5px;">
            @item.Nombre
        </a>
    }
    <hr />
    <a asp-action="Index" class="btn btn-sm btn-outline-light">Limpiar filtros</a>
</aside>

<h1>Catálogo</h1>

@{
    string generoSelec = Utils.SelectSearchFilters(Model.GeneroSeleccionado);
    string tipoRecurso = Utils.SelectType(Model.TipoSeleccionado);
}

<div style="margin-bottom:2rem; margin-top:2rem">
    <span style="color:grey;">Estás filtrando por: @generoSelec en @tipoRecurso</span>
</div>

<section>
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <select name="tipoRecurso" class="form-select" style="max-width: 150px;">
                <option value="">Todos los tipos</option>
                @foreach (var item in Html.GetEnumSelectList<Scriptum.Models.Tipo>())
                {
                    <option value="@item.Value" selected="@(Model.TipoSeleccionado?.ToString() == item.Value)">
                        @item.Text
                    </option>
                }
            </select>
            <input type="text" name="buscar" class="form-control" placeholder="Buscar por título..." value="@Context.Request.Query["buscar"]" />
            <button class="btn btn-primary" type="submit">Buscar</button>
        </div>
    </form>

    <h2>Recursos</h2>
    <br>
    @if (!Model.Libros.Any())
    {
        <p>No se encontraron libros con esos criterios.</p>
    }
    @foreach (var libro in Model.Libros)
    {
        var imagenUrl = string.IsNullOrEmpty(libro.EnlaceImagen)
        ? "https://res.cloudinary.com/dfd0scyd8/image/upload/v1771443710/fprtspu1qmmwsv3edqf1.png"
        : libro.EnlaceImagen.StartsWith("http")
        ? libro.EnlaceImagen
        : Url.Content("~/images/portadas/" + libro.EnlaceImagen);

        <h4>@libro.Titulo</h4>
        <article style="margin-top: 1rem">
            <div class="portada-libro">
                <img style="height:220px; width:150px; object-fit: cover;"
                     src="@imagenUrl"
                     alt="Portada del libro"
                     onerror="this.onerror=null; this.src='https://res.cloudinary.com/dfd0scyd8/image/upload/v1771443710/fprtspu1qmmwsv3edqf1.png';" />
            </div>
            <div class="libro" style="margin-bottom: 2rem;display: block;">
                <p>@libro.Descripcion</p>
                <small>Género: @libro.IdGenero | @libro.FechaSubida.ToShortDateString()</small>
            </div>
            @if (!string.IsNullOrEmpty(@libro.URL))
            {
                <a href="@libro.URL" target="_blank" class="btn" style="max-height:40px; margin-top:auto; margin-left:auto; min-width:10%; background-color: #2C3E50; color: white; border: none;">
                    Descargar 
                </a>
            }
        </article>
        <hr />
    }
    <div class="pagination mt-4">
        @for (int i = 1; i <= Model.TotalPaginas; i++)
        {
            <a asp-action="Index"
            asp-route-pagina="@i"
            asp-route-buscar="@Model.FiltroBusqueda"
            asp-route-generoId="@Model.GeneroSeleccionado"
            asp-route-tipoRecurso="@Context.Request.Query["tipoRecurso"]"
            class="btn me-1 @(i == Model.PaginaActual ? "btn-pagina-activa" : "btn-pagina")">
                @i
            </a>
        }
    </div>
</section>
<script>
    document.getElementById("btn-toggle-filter").addEventListener("click", function() {
        document.getElementById("filtro-sidebar").classList.toggle("active");
    });
</script>


