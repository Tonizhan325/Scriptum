@model CatalogoViewModel;

@{
    ViewData["Title"] = "Index";
}
<style>
    aside {
        position: fixed;
        right: -200px; /* Escondido por defecto (ajusta según el ancho) */
        top: 25%;
        width: 200px;
        background: #2C3E50;
        transition: right 0.3s ease; /* Animación suave */
        z-index: 1000;
        padding: 2rem;
        border-radius: 0 0 0 10px;
    }

        aside.active {
            right: 0; /* Se muestra */
        }

    #btn-toggle-filter {
        position: absolute;
        left: -60px; /* Botón pegado al borde del panel */
        top: 0px;
        background: #2C3E50;
        color: white;
        border: none;
        padding: 10px;
        cursor: pointer;
        border-radius: 5px 0 0 5px;
    }

    section > article {
        display: flex;
        gap: 1rem;
    }
</style>

<!--Esto de abajo habrá que cambiarlo por un grid seguramente para evitar problemas de ancho de contenido-->
<aside id="filtro-sidebar">
    <button id="btn-toggle-filter" title="Filtrar" style="font-size:36px;">
        🔍
    </button>

    <h3 style="color:white; text-align:center; margin-bottom: 1rem;">Filtrar por género</h3>
    @foreach (var item in Model.Generos)
    {
        <a asp-action="Index"
           asp-route-generoId="@item.Id"
           asp-route-tipoRecurso="@Context.Request.Query["tipoRecurso"]"
           asp-route-buscar="@Model.FiltroBusqueda"
           style="color: #ecf0f1; display:block; margin-bottom: 5px;">
            @item.Nombre
        </a>
    }
    <hr />
    <a asp-action="Index" class="btn btn-sm btn-outline-light">Limpiar filtros</a>
</aside>

<h1>Catálogo</h1>

<!--Esto es pura apariencia, hay que cambiarlo-->
@{
    string generoSelec = Utils.SelectSearchFilters(Model.GeneroSeleccionado);
    // Tipo tipo = Utils.SelectType(Model.TipoSeleccionado);
}

<div style="margin-bottom:2rem; margin-top:2rem">
    <span style="color:grey;">Estás filtrando por: @generoSelec en @*@tipoRecursoSelec*@</span>
</div>

<section>
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <select name="tipoRecurso" class="form-select" style="max-width: 150px;">
                <option value="">Todos los tipos</option>
                @foreach (var item in Html.GetEnumSelectList<Scriptum.Models.Tipo>())
                {
                    <option value="@item.Value" selected="@(Context.Request.Query["tipoRecurso"] == item.Value)">
                        @item.Text
                    </option>
                }
            </select>
            <input type="text" name="buscar" class="form-control" placeholder="Buscar por título..." value="@Context.Request.Query["buscar"]" />
            <input type="hidden" name="generoId" value="@Model.GeneroSeleccionado" />
            <button class="btn btn-primary" type="submit">Buscar</button>
        </div>
    </form>

    <h2>Libros</h2>
    @if (!Model.Libros.Any())
    {
        <p>No se encontraron libros con esos criterios.</p>
    }
    @foreach (var libro in Model.Libros)
    {
        string url = Utils.FillEmptyImageUrl(libro.EnlaceImagen);
        
        <h4> @libro.Titulo </h4>
        <article style="margin-top: 1rem">
            <div class="portada-libro">
                <img style="height:220px; width:150px" src=@Html.DisplayFor(modelItem => url) alt="Portada del libro">
            </div>
            <div class="libro" style="margin-bottom: 2rem;">
                <p>@libro.Descripcion</p>
                <small>Género: @libro.IdGenero | @libro.FechaSubida.ToShortDateString()</small>
            </div>
            <button style="max-height: 50px; margin-left:auto; margin-top:auto; width:10rem">Descargar libro</button>
        </article>
        <hr />
    }
    <div class="pagination mt-4">
        @for (int i = 1; i <= Model.TotalPaginas; i++)
        {
            <a asp-action="Index"
               asp-route-pagina="@i"
               asp-route-buscar="@Model.FiltroBusqueda"
               asp-route-generoId="@Model.GeneroSeleccionado"
               asp-route-tipoRecurso="@Context.Request.Query["tipoRecurso"]"
               class="btn @(i == Model.PaginaActual ? "btn-primary" : "btn-outline-primary") me-1">
                @i
            </a>
        }
    </div>
</section>
<script>
    document.getElementById("btn-toggle-filter").addEventListener("click", function() {
        document.getElementById("filtro-sidebar").classList.toggle("active");
    });
</script>


