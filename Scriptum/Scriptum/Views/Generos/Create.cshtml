@model Scriptum.Models.Genero

@{
    ViewData["Title"] = "Crear género";
}

<style>
    /* Estilos generales */
    .page-header {
        background: #2C3E50;
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 2rem 2rem;
        box-shadow: 0 10px 30px rgba(44, 62, 80, 0.3);
    }

    .page-header h1 {
        margin: 0;
        font-weight: 600;
        font-size: 2.5rem;
    }

    .page-header p {
        margin: 0.5rem 0 0 0;
        opacity: 0.9;
    }

    /* Tarjeta del formulario */
    .form-card {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        padding: 2.5rem;
        border: 1px solid #e5e7eb;
        transition: transform 0.3s ease;
        margin-bottom: 2rem;
    }

    .form-card:hover {
        transform: translateY(-5px);
    }

    /* Títulos del formulario */
    .form-title {
        color: #1f2937;
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .form-title svg {
        color: #2C3E50;
    }

    .form-subtitle {
        color: #6b7280;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f3f4f6;
    }

    .form-group-custom {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
        display: block;
        font-size: 0.95rem;
    }

    .form-label i {
        color: #2C3E50;
        margin-right: 0.25rem;
    }

    .form-control-custom {
        border: 2px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        width: 100%;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .form-control-custom:focus {
        border-color: #2C3E50;
        box-shadow: 0 0 0 3px rgba(44, 62, 80, 0.1);
        outline: none;
    }

    .form-control-custom[readonly] {
        background-color: #f3f4f6;
        cursor: not-allowed;
    }

    /* Botón crear */
    .btn-create {
        background: #2C3E50;
        color: white;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        width: 100%;
        justify-content: center;
        margin-top: 1rem;
    }

    .btn-create:hover {
        background: #1a2b3a;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(44, 62, 80, 0.4);
    }

    /* Botón volver */
    .btn-back {
        background: white;
        color: #2C3E50;
        border: 2px solid #2C3E50;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        margin-top: 1.5rem;
    }

    .btn-back:hover {
        background: #2C3E50;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(44, 62, 80, 0.3);
    }

    /* Línea decorativa */
    hr {
        background: linear-gradient(90deg, transparent, #2C3E50, transparent);
        height: 2px;
        border: none;
        margin: 1.5rem 0;
        opacity: 0.2;
    }

    /* Mensajes de validación */
    .text-danger {
        color: #ef4444;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block;
    }

    /* Icono dentro del input */
    .input-icon-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
    }

    .input-icon-field {
        padding-left: 2.5rem;
    }
</style>

<!-- Header -->
<div class="page-header">
    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <p>Añade un nuevo género literario</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-card">

                <!-- Título decorativo -->
                <div class="form-title">
                    <svg width="32" height="32" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z" />
                    </svg>
                    Nuevo Género
                </div>
                <p class="form-subtitle">Completa los datos del género</p>

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-group-custom">
                        <label asp-for="Id" class="form-label">
                            <i class="fas fa-hashtag"></i> Código del género
                        </label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">
                                <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.616a1 1 0 01.894-1.79l1.599.8L9 4.323V3a1 1 0 011-1z" clip-rule="evenodd" />
                                </svg>
                            </span>
                            <input asp-for="Id" class="form-control-custom input-icon-field" placeholder="Ej: CIEN, NOV, TER..." />
                        </div>
                        <span asp-validation-for="Id" class="text-danger"></span>
                        <small class="help-tooltip">
                            <svg fill="currentColor" viewBox="0 0 20 20" width="14" height="14">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                            Código único para identificar el género
                        </small>
                    </div>

                    <!-- Nombre -->
                    <div class="form-group-custom">
                        <label asp-for="Nombre" class="form-label">
                            <i class="fas fa-tag"></i> Nombre del género
                        </label>
                        <div class="input-icon-wrapper">
                            <span class="input-icon">
                                <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                                </svg>
                            </span>
                            <input asp-for="Nombre" class="form-control-custom input-icon-field" placeholder="Ej: Ciencia Ficción, Novela, Terror..." />
                        </div>
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <hr />

                    <button type="submit" class="btn-create">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                        </svg>
                        Crear género
                    </button>
                </form>

                <div class="text-center">
                    <a asp-action="Index" class="btn-back">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                        </svg>
                        Volver a la lista
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
