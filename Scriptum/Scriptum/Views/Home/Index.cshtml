@{
    ViewData["Title"] = "Scriptum - Inicio";
}

<style>

    .tarjeta-explorar {
        width: 25%;
        text-decoration: none;
        color: inherit;
    }

        .tarjeta-explorar section {
            transition: all 0.4s ease;
        }

        .tarjeta-explorar:hover section {
            transform: translateY(-5px);
        }

</style>

<div style="position: relative; width: 100%; overflow: hidden; display: flex; justify-content: center;">

    <!-- TÍTULO: Con posición absoluta para que flote sobre el video -->
    <h1 style="position: absolute; z-index: 1; color: white; font-size: 3rem; text-align: left; text-shadow: 2px 2px 10px rgba(0,0,0,0.5); padding:50px; margin-right:auto;">
        Scriptum - Tu biblioteca colaborativa en línea
    </h1>

    <!-- VIDEO: Asegúrate de que ocupe todo el fondo -->
    <video autoplay muted loop playsinline disablePictureInPicture
           style="pointer-events: none; width: 100%; height: 60%; object-fit: cover; filter: grayscale(60%);">
        <source src="~/videos/video-presentacion-scriptum.mp4" type="video/mp4">
        Tu navegador no soporta videos.
    </video>

</div>

<main>
    <div id="explorar" style="display:flex; align-items: center; justify-content:center; gap: 1rem; margin-top: 2.5rem;">

        <a href="~/Catalogo/Index" class="tarjeta-explorar">
            <section style="height:150px; display:flex; align-items:center; justify-content:center;
                        background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/libros.jpg');
                        background-size: cover; background-position: center; border-radius: 8px;">
            <h2 style="color: white; text-align: center;">Libros</h2>
        </section></a>

        <a href="~/Catalogo/Index" class="tarjeta-explorar">
            <section style="height:150px; display:flex; align-items:center; justify-content:center;
                        background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/comics.jpg');
                        background-size: cover; background-position: center; border-radius: 8px;">
            <h2 style="color: white; text-align: center;">Cómics/Mangas</h2>
        </section></a>

        <a href="~/Catalogo/Index" class="tarjeta-explorar">
            <section style="height:150px; display:flex; align-items:center; justify-content:center;
                        background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/revistas.jpg');
                        background-size: cover; background-position: center; border-radius: 8px;">
            <h2 style="color: white; text-align: center;">Revistas</h2>
        </section></a>

        <a href="~/Catalogo/Index" class="tarjeta-explorar">
            <section style="height:150px; display:flex; align-items:center; justify-content:center;
                        background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/articulos.jpg');
                        background-size: cover; background-position: center; border-radius: 8px;">
            <h2 style="color: white; text-align: center;">Artículos científicos</h2>
        </section></a>
 
    </div>
</main>
  

