@{
    ViewData["Title"] = "Scriptum - Inicio";
}

<style>

    .tarjeta-explorar {
        width: 25%;
        text-decoration: none;
        color: inherit;
    }

        .tarjeta-explorar section {
            transition: all 0.4s ease;
        }

        .tarjeta-explorar:hover section {
            transform: translateY(-5px);
        }

    #panel1, #panel2, #panel3 {
        width: 95%;
        height: 50vh;
        background-color: #2C3E50;
        margin: 0 auto;
        text-align: center;
        align-content: center;
        font-size: 6rem;
        margin-top: 5%;
        border-radius: 5vw;
        color: white;
        transition: all 0.3s ease;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        #panel1:hover, #panel2:hover, #panel3:hover {
            background-color: #1a2b3a;
            transform: scale(1.02);
            box-shadow: 0 20px 40px rgba(44, 62, 80, 0.4);
        }

        #panel1 svg, #panel2 svg, #panel3 svg {
            transition: transform 0.3s ease;
        }

        #panel1:hover svg, #panel2:hover svg, #panel3:hover svg {
            transform: scale(1.1);
        }

</style>

@if (User.Identity.IsAuthenticated)
{
    @if (User.IsInRole("Usuario"))
    {
        <div style="position: relative; width: 100%; overflow: hidden; display: flex; justify-content: center;">

            <!-- TÍTULO: Con posición absoluta para que flote sobre el video -->
            <h1 style="position: absolute; z-index: 1; color: white; font-size: 3rem; text-align: left; text-shadow: 2px 2px 10px rgba(0,0,0,0.5); padding:50px; margin-right:auto;">
                Scriptum - Tu biblioteca colaborativa en línea
            </h1>

            <!-- VÍDEO -->
            <video autoplay muted loop playsinline disablePictureInPicture
                   style="pointer-events: none; width: 100%; height: 60%; object-fit: cover; filter: grayscale(60%);">
                <source src="~/videos/video-presentacion-scriptum.mp4" type="video/mp4">
                Tu navegador no soporta videos.
            </video>

        </div>

        <main>
            <div id="explorar" style="display:flex; align-items: center; justify-content:center; gap: 1rem; margin-top: 2.5rem;">

                <a href="~/Catalogo/Index?tipoRecurso=0" class="tarjeta-explorar">
                    <section style="height:150px; display:flex; align-items:center; justify-content:center;
                                    background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/libros.jpg');
                                    background-size: cover; background-position: center; border-radius: 8px;">
                        <h2 style="color: white; text-align: center;">Libros</h2>
                    </section>
                </a>

                <a href="~/Catalogo/Index?tipoRecurso=1" class="tarjeta-explorar">
                    <section style="height:150px; display:flex; align-items:center; justify-content:center;
                                    background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/comics.jpg');
                                    background-size: cover; background-position: center; border-radius: 8px;">
                        <h2 style="color: white; text-align: center;">Cómics/Mangas</h2>
                    </section>
                </a>

                <a href="~/Catalogo/Index?tipoRecurso=2" class="tarjeta-explorar">
                    <section style="height:150px; display:flex; align-items:center; justify-content:center;
                                    background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/revistas.jpg');
                                    background-size: cover; background-position: center; border-radius: 8px;">
                        <h2 style="color: white; text-align: center;">Revistas</h2>
                    </section>
                </a>

                <a href="~/Catalogo/Index?tipoRecurso=3" class="tarjeta-explorar">
                    <section style="height:150px; display:flex; align-items:center; justify-content:center;
                                    background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/img/articulos.jpg');
                                    background-size: cover; background-position: center; border-radius: 8px;">
                        <h2 style="color: white; text-align: center;">Artículos científicos</h2>
                    </section>
                </a>

            </div>
        </main>
    }
    @if (User.IsInRole("Administrador"))
{
    <style>

        .admin-dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        .admin-header {
            margin-bottom: 3rem;
            position: relative;
        }

        .admin-header-content {
            text-align: center;
        }

        .admin-header-content h1 {
            font-size: 2.5rem;
            font-weight: 700;
            background: linear-gradient(135deg, #1e293b 0%, #2c3e50 100%);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
        }

        .admin-header-content p {
            color: #5a6e85;
            font-size: 1.1rem;
            font-weight: 500;
        }

        .admin-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1.8rem;
            margin-top: 1rem;
        }

        .admin-card {
            background: white;
            border-radius: 1.5rem;
            padding: 1.8rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(203, 213, 225, 0.5);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
            display: flex;
            align-items: center;
            gap: 1.5rem;
            backdrop-filter: blur(0px);
        }

        .admin-card:hover {
            transform: translateY(-6px);
            border-color: #2c3e50;
            box-shadow: 0 20px 30px -12px rgba(44, 62, 80, 0.15);
            background: linear-gradient(135deg, #ffffff 0%, #fafcff 100%);
        }

        .admin-card-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #2c3e50 0%, #1a2a3a 100%);
            border-radius: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .admin-card-icon svg {
            width: 36px;
            height: 36px;
            color: white;
        }

        .admin-card:hover .admin-card-icon {
            transform: scale(1.02);
            background: linear-gradient(135deg, #1a2a3a 0%, #0f1a24 100%);
        }

        .admin-card-content {
            flex: 1;
        }

        .admin-card-content h3 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0 0 0.4rem 0;
            letter-spacing: -0.01em;
        }

        .admin-card-content p {
            font-size: 0.9rem;
            color: #5a6e85;
            margin: 0 0 0.8rem 0;
            line-height: 1.4;
        }

        .admin-card-action {
            font-size: 0.85rem;
            font-weight: 600;
            color: #2c3e50;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s ease;
        }

        .admin-card:hover .admin-card-action {
            color: #1a2a3a;
            transform: translateX(4px);
        }

        @@media (max-width: 768px) {
            .admin-dashboard-container {
                padding: 1rem;
            }
            
            .admin-grid {
                gap: 1rem;
            }
            
            .admin-card {
                padding: 1.2rem;
                gap: 1rem;
            }
            
            .admin-card-icon {
                width: 55px;
                height: 55px;
            }
            
            .admin-card-icon svg {
                width: 28px;
                height: 28px;
            }
            
            .admin-card-content h3 {
                font-size: 1.2rem;
            }
            
            .admin-header-content h1 {
                font-size: 1.8rem;
            }
        }

        .admin-card {
            animation: fadeInUp 0.4s ease-out backwards;
        }

        .admin-card:nth-child(1) { animation-delay: 0.05s; }
        .admin-card:nth-child(2) { animation-delay: 0.1s; }
        .admin-card:nth-child(3) { animation-delay: 0.15s; }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        </style>
    <div class="admin-dashboard-container">

        <div class="admin-header">
            <div class="admin-header-content">
                <h1>Panel de Administración</h1>
                <p>Gestión completa de la plataforma Scriptum</p>
            </div>
        </div>

        <div class="admin-grid">

            <a href="~/Usuarios/Index" class="admin-card">
                <div class="admin-card-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <div class="admin-card-content">
                    <h3>Usuarios</h3>
                    <p>Gestionar cuentas, roles y permisos</p>
                    <span class="admin-card-action">Administrar →</span>
                </div>
            </a>

            <a href="~/Libros/Index" class="admin-card">
                <div class="admin-card-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                </div>
                <div class="admin-card-content">
                    <h3>Libros</h3>
                    <p>Catálogo, stock y disponibilidad</p>
                    <span class="admin-card-action">Administrar →</span>
                </div>
            </a>

            <a href="~/Generos/Index" class="admin-card">
                <div class="admin-card-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                </div>
                <div class="admin-card-content">
                    <h3>Géneros</h3>
                    <p>Clasificación y categorías literarias</p>
                    <span class="admin-card-action">Administrar →</span>
                </div>
            </a>
        </div>
    </div>

    
}
}
else
{
    <div style="position: relative; width: 100%; overflow: hidden; display: flex; justify-content: center;">

        <h1 style="position: absolute; z-index: 1; color: white; font-size: 3rem; text-align: left; text-shadow: 2px 2px 10px rgba(0,0,0,0.5); padding:50px; margin-right:auto;">
