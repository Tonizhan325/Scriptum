@* @model IEnumerable<Scriptum.Models.Usuario> *@
@model PaginatedList<Scriptum.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #2C3E50 0%, #1a2b3a 100%);
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 2rem 2rem;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

        .page-header h1 {
            margin: 0;
            font-weight: 600;
            font-size: 2.5rem;
        }

        .page-header p {
            margin: 0.5rem 0 0 0;
            opacity: 0.9;
        }

    .search-container {
        background: white;
        padding: 1.5rem;
        border-radius: 1rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        margin-bottom: 2rem;
        border: 1px solid #e5e7eb;
    }

    .search-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
        display: block;
    }

    .search-input {
        border: 2px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }

        .search-input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            outline: none;
        }

    .btn-search {
        background: #2C3E50;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        margin-right: 0.5rem;
    }

        .btn-search:hover {
            background-color: #2C3E50;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }

    .btn-reset {
        background: #f3f4f6;
        color: #4b5563;
        border: 2px solid #e5e7eb;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-reset:hover {
            background: #e5e7eb;
            color: #1f2937;
            transform: translateY(-2px);
        }

    .btn-create {
        background: #2C3E50;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        text-decoration: none;
    }

        .btn-create:hover {
            background: #1a2b3a;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(16, 185, 129, 0.4);
            color: white;
        }

    .btn-back {
        background: #2C3E50;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        margin-left: 1rem;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #2C3E50;
            transform: translateY(-2px);
            color: white;
        }

    .btn-back-pagination {
        background: #2C3E50;
        color: white;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-back-pagination:hover {
            background: #2C3E50;
            transform: translateY(-2px);
            color: white;
        }

    .top-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .left-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .table-container {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        overflow: hidden;
        border: 1px solid #e5e7eb;
        margin-bottom: 2rem;
    }

    .custom-table {
        margin-bottom: 0;
        width: 100%;
    }

        .custom-table thead {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        }

        .custom-table th {
            color: #4a5568;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.05em;
            padding: 1rem 0.75rem;
            border-bottom: 2px solid #dee2e6;
            white-space: nowrap;
        }

        .custom-table td {
            padding: 1rem 0.75rem;
            vertical-align: middle;
            color: #4b5563;
            border-bottom: 1px solid #e5e7eb;
        }

        .custom-table tbody tr:hover {
            background-color: #f8fafc;
            transition: background-color 0.3s ease;
        }

    .badge-active {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
        text-align: center;
    }

    .badge-inactive {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
        text-align: center;
    }

    .badge-pending {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-block;
        text-align: center;
    }

    .action-links {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-start;
    }

    .action-link {
        color: #2C3E50;
        transition: all 0.3s ease;
        text-decoration: none;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .action-link:hover {
        transform: translateY(-2px);
        color: #1a2b3a; 
        text-decoration: none;
    }

    .separator {
        color: #d1d5db;
        font-weight: 300;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 2rem;
        flex-wrap: wrap;
    }

    .btn-pagination {
        background: white;
        border: 2px solid #e5e7eb;
        color: #4b5563;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-pagination:not(.disabled):hover {
            background: #2C3E50;
            color: white;
            border-color: transparent;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-pagination.disabled {
            opacity: 0.5;
            cursor: not-allowed;
            pointer-events: none;
        }

    .results-count {
        color: #6b7280;
        font-size: 0.9rem;
        margin-top: 0.5rem;
        text-align: center;
    }
</style>

<div class="page-header">
    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <p>Administra todos los usuarios del sistema</p>
    </div>
</div>

<div class="container">
    <div class="top-buttons">
        <div class="left-buttons">
            <a asp-action="Create" class="btn-create">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
                Nuevo Usuario
            </a>
            <a href="~/Home/Index" class="btn-back">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                </svg>
                Volver
            </a>
        </div>
    </div>

    <div class="search-container">
        <form asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="search-label">Buscar usuario</label>
                    <input type="text" name="strCadenaBusqueda"
                           value="@ViewData["BusquedaActual"]"
                           class="form-control search-input"
                           placeholder="Nombre del usuario..." />
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn-search">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" style="margin-right: 0.5rem;">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                        </svg>
                        Buscar
                    </button>
                    <a asp-action="Index" class="btn-reset">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" style="margin-right: 0.5rem;">
                            <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd" />
                        </svg>
                        Limpiar filtros
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Contraseña</th>
                    <th>Correo electrónico</th>
                    <th>Fecha de registro</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@Html.DisplayFor(modelItem => item.Nombre)</strong></td>
                        <td>••••••••</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.fechaRegistro)</td>
                        <td>
                            @{
                                var estadoClass = "badge-pending";
                                var estadoTexto = "Pendiente";

                                if (!string.IsNullOrEmpty(item.Estado))
                                {
                                    switch (item.Estado.ToLower())
                                    {
                                        case "activo":
                                            estadoClass = "badge-active";
                                            estadoTexto = "Activo";
                                            break;
                                        case "inactivo":
                                            estadoClass = "badge-inactive";
                                            estadoTexto = "Inactivo";
                                            break;
                                        default:
                                            estadoClass = "badge-pending";
                                            estadoTexto = item.Estado;
                                            break;
                                    }
                                }
                            }
                            <span class="@estadoClass">@estadoTexto</span>
                         </td>
                        <td>
                            <div class="action-links">
                                <a asp-action="Details" asp-route-id="@item.Id" class="action-link view" title="Ver perfil">
                                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                                        <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                                <span class="separator">|</span>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="action-link edit" title="Editar">
                                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                                    </svg>
                                </a>
                                <span class="separator">|</span>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="action-link delete" title="Eliminar">
                                    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            </div>
                         </td>
                     </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="results-count">
        Mostrando @Model.Count usuarios
    </div>

    @{
        var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
        var nextDisabled = !Model.HasNextPage ? "disabled" : "";
    }

    <div class="pagination-container">
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-strCadenaBusqueda="@ViewData["BusquedaActual"]"
           class="btn-pagination @prevDisabled">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Anterior
        </a>
        
        <a href="~/Home/Index" class="btn-back-pagination">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Volver
        </a>
        
        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-strCadenaBusqueda="@ViewData["BusquedaActual"]"
           class="btn-pagination @nextDisabled">
            Siguiente
            <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
        </a>
    </div>
</div>