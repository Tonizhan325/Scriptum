<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Scriptum</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-scriptum">
            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logoScriptum.png" alt="Scriptum" />
                    <div>
                        <div>SCRIPTUM</div>
                        <small class="text-light opacity-75">Biblioteca digital colaborativa</small>
                    </div>
                </a>

                <!-- TOGGLER -->
                <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">

                    <!-- LINKS CENTRALES -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Usuario"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Inicio</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Catálogo</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Compartir libro</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Contacto</a>
                                </li>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Usuarios" asp-action="Index">Ver usuarios</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Libros" asp-action="Index">Ver libros</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Generos" asp-action="Index">Ver géneros</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="#">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">Catálogo</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">Contacto</a>
                            </li>
                        }

                    </ul>

                    <!-- BUSCADOR + AVATAR -->
                    <div class="d-flex align-items-center">
                        <div class="search-wrapper">
                            <input class="form-control search-input" type="search" placeholder="Search" />
                        </div>

                        <partial name="_LoginPartial" />
                        <div class="avatar">
                            👤
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-fill">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto">
        <div class="container">
            &copy; 2026 - Scriptum - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
