@* @model IEnumerable<Scriptum.Models.Libro> *@
@model PaginatedList<Scriptum.Models.Libro>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>

@* Agregar un cuadro de búsqueda en la vista Index de Avisos *@
<form asp-action="Index">
    <div class="container">
        <div class="row align-items-start">
            <div class="col-md">
                <label class="control-label">Título del libro:</label>
                <input type="text" name="strCadenaBusqueda"
                       value="@ViewData["BusquedaActual"]" class="form-control" />
            </div>
            <div class="col-md align-self-end">
                <input type="submit" value="Buscar" class="btn btn-default" /> |
                <a asp-action="Index" class="btn btn-default">Lista completa</a>
            </div>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                Título
                @* @Html.DisplayNameFor(model => model.Titulo) *@
            </th>
            <th>
                Descripción
                @* @Html.DisplayNameFor(model => model.Descripcion) *@
            </th>
            <th>
                Idioma
                @* @Html.DisplayNameFor(model => model.Idioma) *@
            </th>
            <th>
                Tamaño de archivo
                @* @Html.DisplayNameFor(model => model.TamañoArchivo) *@
            </th>
            <th>
                URL
                @* @Html.DisplayNameFor(model => model.URL) *@
            </th>
            <th>
                Fecha de subida
                @* @Html.DisplayNameFor(model => model.FechaSubida) *@
            </th>
            <th>
                Fecha de revisión
                @* @Html.DisplayNameFor(model => model.FechaRevision) *@
            </th>
            <th>
                IdUsuario
                @* @Html.DisplayNameFor(model => model.IdUsuario) *@
            </th>
            <th>
                IdGenero
                @* @Html.DisplayNameFor(model => model.IdGenero) *@
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Titulo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Idioma)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TamañoArchivo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.URL)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaSubida)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaRevision)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdUsuario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdGenero)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Borrar</a>
            </td>
        </tr>
}
    </tbody>
</table>

@* Poner botones de página Siguiente y Anterior *@
@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}
<a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)"
   class="btn btn-outline-secondary @prevDisabled">
    Anterior
</a>
<a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)"
   class="btn btn-outline-secondary @nextDisabled">
    Siguiente
</a>

