@model Scriptum.Models.Libro

@{
    ViewData["Title"] = "Detalles del libro";
}

<style>

    .page-header {
        background: #2C3E50;
        color: white;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 2rem 2rem;
        box-shadow: 0 10px 30px rgba(44, 62, 80, 0.3);
    }

        .page-header h1 {
            margin: 0;
            font-weight: 600;
            font-size: 2.5rem;
        }

        .page-header p {
            margin: 0.5rem 0 0 0;
            opacity: 0.9;
        }

    .details-card {
        background: white;
        border-radius: 1.5rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.08);
        padding: 2.5rem;
        border: 1px solid #e5e7eb;
        transition: transform 0.3s ease;
        margin-bottom: 2rem;
    }

        .details-card:hover {
            transform: translateY(-5px);
        }

    .book-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid #f3f4f6;
    }

    .book-cover {
        width: 100px;
        height: 120px;
        background: linear-gradient(135deg, #2C3E50, #1a2b3a);
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 5px 15px rgba(44, 62, 80, 0.3);
    }

        .book-cover svg {
            width: 50px;
            height: 50px;
        }

    .book-title-section {
        flex: 1;
    }

    .book-title {
        font-size: 2rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .book-author {
        font-size: 1.1rem;
        color: #6b7280;
    }

        .book-author span {
            color: #2C3E50;
            font-weight: 600;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .info-section {
        background: #f9fafb;
        border-radius: 1rem;
        padding: 1.5rem;
    }

    .info-section-title {
        font-size: 1rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .info-section-title svg {
            color: #2C3E50;
        }

    .info-row {
        display: flex;
        padding: 0.75rem 0;
        border-bottom: 1px solid #e5e7eb;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        flex: 0 0 120px;
        font-weight: 600;
        color: #6b7280;
    }

    .info-value {
        flex: 1;
        color: #1f2937;
    }

    .badge-language {
        background: #2C3E50;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 500;
        display: inline-block;
    }

    .file-size {
        font-family: monospace;
        background: #f3f4f6;
        padding: 0.25rem 0.5rem;
        border-radius: 0.5rem;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }

    .btn-edit {
        background: #2C3E50;
        color: white;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: #1a2b3a;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(44, 62, 80, 0.4);
            color: white;
        }

    .btn-back {
        background: white;
        color: #2C3E50;
        border: 2px solid #2C3E50;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #2C3E50;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(44, 62, 80, 0.3);
        }

    .description-box {
        background: #f9fafb;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-top: 1.5rem;
    }

        .description-box p {
            color: #4b5563;
            line-height: 1.6;
            margin: 0;
        }
</style>

<div class="page-header">
    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <p>Información detallada del libro</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="details-card">

                <div class="book-header">
                    <div class="book-cover">
                        <svg viewBox="0 0 20 20" fill="currentColor">
                            <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z" />
                        </svg>
                    </div>
                    <div class="book-title-section">
                        <div class="book-title">@Model.Titulo</div>
                        <div class="book-author">por <span>@Model.NombreAutor</span></div>
                    </div>
                </div>


                <div class="info-grid">

                    <div class="info-section">
                        <div class="info-section-title">
                            <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                            Información general
                        </div>
                        <div class="info-row">
                            <div class="info-label">Idioma</div>
                            <div class="info-value">
                                <span class="badge-language">@Model.Idioma</span>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Tamaño</div>
                            <div class="info-value">
                                    @{
                                        decimal? tamañoDecimal = Model.TamañoArchivo;
                                        string tamañoFormateado = "0 B";

                                        if (tamañoDecimal.HasValue)
                                        {
                                            double tamaño = (double)tamañoDecimal.Value;

                                            if (tamaño >= 1048576)
                                            {
                                                tamañoFormateado = $"{tamaño / 1048576.0:F1} MB";
                                            }
                                            else if (tamaño >= 1024)
                                            {
                                                tamañoFormateado = $"{tamaño / 1024.0:F1} KB";
                                            }
                                            else
                                            {
                                                tamañoFormateado = $"{tamaño:F0} B";
                                            }
                                        }
                                    }
                                    <span class="file-size">@tamañoFormateado</span>
                            </div>
                        </div>
                    </div>

                    <div class="info-section">
                        <div class="info-section-title">
                            <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                            </svg>
                            Fechas
                        </div>
                        <div class="info-row">
                            <div class="info-label">Subida</div>
                            <div class="info-value">@Model.FechaSubida.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Revisión</div>
                            <div class="info-value">@Model.FechaRevision?.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>

                    <div class="info-section" style="grid-column: span 2;">
                        <div class="info-section-title">
                            <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.616a1 1 0 01.894-1.79l1.599.8L9 4.323V3a1 1 0 011-1z" clip-rule="evenodd" />
                            </svg>
                            Identificadores
                        </div>
                        <div class="info-row">
                            <div class="info-label">ID Usuario</div>
                            <div class="info-value">@Model.IdUsuario</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">ID Género</div>
                            <div class="info-value">@Model.IdGenero</div>
                        </div>
                    </div>
                </div>

                <div class="description-box">
                    <div class="info-section-title">
                        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                        </svg>
                        Descripción
                    </div>
                    <p>@Model.Descripcion</p>
                </div>

                <div class="action-buttons">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit">
                        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
                            <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                        </svg>
                        Editar libro
                    </a>
                    <a asp-action="Index" class="btn-back">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                        </svg>
                        Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
